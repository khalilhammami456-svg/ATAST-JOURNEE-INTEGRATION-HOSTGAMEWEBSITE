{
  "name": "atast-platform",
  "version": "1.0.0",
  "private": true,
  "description": "ATAST Club (ISIMM) — gestion des membres, événements, points et communication",
  "main": "backend/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.js",
    "dev": "node --env-file-if-exists=.env --watch backend/server.js",
    "create-admin": "node --env-file-if-exists=.env database/seeds/create-admin.js",
    "seed:demo": "node --env-file-if-exists=.env database/seeds/demo.js",
    "test": "node --test tests/*.test.js",
    "backup": "node --env-file-if-exists=.env database/backup.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "read-excel-file": "^9.3.10",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "fflate": "^0.8.3"
  }
}
