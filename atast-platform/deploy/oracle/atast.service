[Unit]
Description=ATAST club platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=atast
Group=atast
WorkingDirectory=/opt/atast/app
EnvironmentFile=/etc/atast/atast.env
ExecStart=/usr/bin/node backend/server.js
Restart=always
RestartSec=3
# Let open live-sync streams close before the process is killed
TimeoutStopSec=15

# Hardening: the service can only write to its data folder
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/atast
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
