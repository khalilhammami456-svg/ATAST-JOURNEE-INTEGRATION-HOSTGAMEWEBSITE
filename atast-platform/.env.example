# Copy to .env and adjust. Never commit real values.
NODE_ENV=production
PORT=3000
# Public URL (HTTPS is mandatory in production)
APP_URL=https://atast.example.tn
# SQLite database file (created automatically, migrations run at start-up)
DATABASE_URL=./database/atast.sqlite
# Uploaded photos / event images (outside the public web root)
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=2097152
# Excel / CSV import of paid subscriptions (Administration > Cotisations)
IMPORT_MAX_BYTES=2097152
IMPORT_MAX_ROWS=2000
# Auto-accept requires the phone number to match the paid list as well as the email (recommended)
AUTO_ACCEPT_REQUIRE_PHONE=true
# `npm run backup` (optional)
# BACKUP_DIR=./database/backups
# BACKUP_KEEP=14

# Sessions and security
SESSION_TTL_HOURS=168
BCRYPT_ROUNDS=12
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_ATTEMPTS=10
CLUB_TIMEZONE=Africa/Tunis

# Only used by `npm run create-admin`
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
